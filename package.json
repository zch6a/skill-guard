{
  "name": "skill-guard",
  "version": "1.3.0",
  "description": "Find prompt injection, data exfiltration and hidden instructions in the Skills, plugins, hooks and MCP servers your AI agents run. Local, deterministic, zero dependencies.",
  "keywords": [
    "agent-skills",
    "skill-md",
    "mcp",
    "mcp-security",
    "prompt-injection",
    "claude-code",
    "codex",
    "cursor",
    "deepseek",
    "supply-chain",
    "security",
    "sarif",
    "scanner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zch6a/skill-guard.git"
  },
  "homepage": "https://github.com/zch6a/skill-guard#readme",
  "bugs": {
    "url": "https://github.com/zch6a/skill-guard/issues"
  },
  "type": "module",
  "bin": {
    "skill-guard": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "node src/bin.ts",
    "test": "node --import ./test/isolate.ts --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "corpus": "node scripts/corpus.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
